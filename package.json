{
  "name": "dsh-plugin-manager",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "DSH 插件管理器：在设置页检测并更新已安装的 GitHub 插件，带待更新标签、刷新并检测、全部更新；不占用页签、不替换原生页面。",
  "license": "MIT",
  "main": "index.js",
  "icon": "icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/longyi-0x0/dsh-plugin-manager.git"
  },
  "homepage": "https://github.com/longyi-0x0/dsh-plugin-manager#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "client",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin-manager",
    "github"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
